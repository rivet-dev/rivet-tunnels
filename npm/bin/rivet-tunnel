#!/usr/bin/env node

const { execFileSync } = require("node:child_process");
const fs = require("node:fs");
const path = require("node:path");

const packages = {
  "darwin-arm64": "@rivet-labs/tunnel-darwin-arm64",
  "darwin-x64": "@rivet-labs/tunnel-darwin-x64",
  "linux-arm64": "@rivet-labs/tunnel-linux-arm64",
  "linux-x64": "@rivet-labs/tunnel-linux-x64",
  "win32-x64": "@rivet-labs/tunnel-win32-x64"
};

const key = `${process.platform}-${process.arch}`;
const packageName = packages[key];
if (!packageName) {
  console.error(`Unsupported platform: ${key}`);
  process.exit(1);
}

try {
  const packagePath = require.resolve(`${packageName}/package.json`);
  const binaryName = process.platform === "win32" ? "rivet-tunnel.exe" : "rivet-tunnel";
  const binaryPath = path.join(path.dirname(packagePath), "bin", binaryName);
  if (process.platform !== "win32") {
    fs.chmodSync(binaryPath, 0o755);
  }
  execFileSync(binaryPath, process.argv.slice(2), { stdio: "inherit" });
} catch (error) {
  if (error && typeof error.status === "number") {
    process.exit(error.status);
  }
  console.error(`Could not run ${packageName}. Reinstall @rivet-labs/tunnel for this platform.`);
  process.exit(1);
}
